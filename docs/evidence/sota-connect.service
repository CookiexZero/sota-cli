[Unit]
# Sota's copy of kittencore/core/dist/linux/kittend.service — the core ships
# that unit with Faygo's identity as a template for consumers to rebrand.
# Every "sota-connect" below must match SotaDaemonIdentity.brandSlug
# (lib/core/desktop/sota_daemon_identity.dart) byte for byte: the app derives
# /run/sota-connect/kittend.sock and /var/lib/sota-connect from it, and the
# socket group is what lets it connect at all.
#
# Named sota-connect.service, not sotad.service: on an RPM upgrade the OLD
# package's %preun runs after the new %post and stops + disables sotad.service
# unconditionally — reusing the name would have it kill the fresh daemon.
Description=Sota Connect VPN daemon (KittenCore)
Documentation=https://sotavpn.net/
After=network.target
Wants=network.target
# Never give up restarting (with Restart= below). A [Unit] key: under
# [Service] systemd logs "Unknown key" and keeps the default start limit.
StartLimitIntervalSec=0

[Service]
Type=simple
# User is left unset (root): sing-tun opens /dev/net/tun, installs routes and
# manages DNS. Group=sota-connect makes the daemon's PRIMARY group
# sota-connect, which is what gives RuntimeDirectory/StateDirectory below the
# right group without a separate chown.
Group=sota-connect
ExecStart=/usr/libexec/sota-connect/kittend --state-dir /var/lib/sota-connect --endpoint /run/sota-connect/kittend.sock --socket-group sota-connect

RuntimeDirectory=sota-connect
RuntimeDirectoryMode=0750
StateDirectory=sota-connect
# 0710 (not 0700): the GUI must be able to TRAVERSE into rule_sets/ (created
# 2770 by the daemon itself) without being able to list the working dir.
StateDirectoryMode=0710

# Retry indefinitely on failure, like the Windows SCM policy. RestartSteps=
# needs systemd 254, which Debian stable lacks, so the interval is a flat 5 s.
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sota-connect
# AF_NETLINK and CAP_SYS_PTRACE are LOAD-BEARING for per-app split:
# sing-box's Linux process searcher resolves the socket owner over netlink
# sock_diag, then walks /proc/<pid>/fd to find the process holding that socket
# and reads /proc/<pid>/exe of it. Drop AF_NETLINK, CAP_SYS_PTRACE or
# CAP_DAC_READ_SEARCH and per-app split silently stops matching.
# CAP_DAC_READ_SEARCH is the easy one to miss: /proc/<pid>/fd is mode 0500 and
# owned by the process's user, so a root service that lost the DAC bypass can
# open only root's own processes — the log then says "find process path:
# process of uid(1000), inode(N) not found" for every user app (seen on Ubuntu
# 26.04: NetworkManager was found, Firefox and curl never were).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_CHOWN CAP_FOWNER CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
# CAP_DAC_READ_SEARCH also unlocks open_by_handle_at(2) — the container-escape
# primitive (shocker) that reads any file on the host by file handle. Nothing
# in kittend or the sing-box stack calls it (checked in kittencore and its
# dependency tree), so a compromised daemon does not get it for free.
SystemCallFilter=~open_by_handle_at name_to_handle_at

# Logs go to the journal: journalctl -u sota-connect
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kittend

[Install]
WantedBy=multi-user.target
